# ---- Sunucu ----
PORT=3000
# Oturum imzalama anahtarı. Rastgele ve uzun olmalı:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=buraya_uzun_rastgele_bir_deger_yazin

# ---- Kimlik sağlayıcılar ----
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_TENANT=common

# ---- Erişim kuralı ----
ALLOWED_SUFFIX=.edu.tr
# Admin yetkisi verilecek e-postalar (virgülle ayrılır). Bu adresler uzantı kuralından muaftır.
ADMIN_EMAILS=ogr.gorevlisi@universite.edu.tr

# ---- Geliştirme ----
# true yapılırsa parolasız "e-posta ile giriş" açılır. CANLI ORTAMDA false OLMALI.
DEV_LOGIN=false

# Uygulamanın gömüleceği site adresleri (virgülle ayrılır). Boşsa aynı origin dışına izin verilmez.
ALLOWED_ORIGINS=https://www.universite.edu.tr,https://protez.universite.edu.tr
